<?xml version="1.0"?>
<!--
  AGL-CHS-03-F01 通用智能底盘 —— 按三视图重建的最小仿真模型（E05 / W2）

  ── 形状依据：PDF 第 3 页三视图（2026-10-31 逐项绘图测量）─────────────────
  俯视图显示车体是「旋转 45° 的方形 + 四角截平」的八边形：
    · 4 个 45° 斜面（NE/NW/SE/SW 朝向）—— 每个斜面上装一个全向轮
    · 4 个被截平的轴向面（前/后/左/右）
    · 包络 W643 × L656 mm；含轮整体包络 726 × 726 mm
    · 顶部中央为 254 × 190 mm 安装板（人形上装接口）
    · 两台 3D 雷达对角布置，带支座立起
  前视图显示：离地总高 H = 251 mm，车体高 = 251 − 25（离地间隙）= 226 mm，
    轮子只在车体下方外露。

  ── 参数来源 ──────────────────────────────────────────────────────────
  【PDF】W643 / L656 / 726×726×251 / 离地 25 mm / 8 寸全向轮 210 mm / 自重 ≤65 kg /
         中心安装板 254×190 / 2 台 3D 固态雷达对角 + IMU 集成于雷达（200 Hz）
  【推导】图纸上的 726 尺寸线是一条与轮子外缘**相切**的 45° 细线，因此 726 是
         「跨轮、垂直于 45° 斜面的距离」，不是 X/Y 外接方盒：
           e + W/2 = 726/2 = 363  →  e = 333 mm（轮心到中心的法向距离）
           轮心 |x| = |y| = e/√2 = 235.46 mm
         X/Y 外接包络因此是 (e + D/2 + W/2)·√2 = 662 mm（而非 726）。
         规格书表格里的“整机尺寸 726×726”与图纸这条尺寸线一致，但按外接方盒理解会差 64 mm，
         已在 docs/engineering/robot_model.md 5.2 作为文档冲突登记。
         斜面法向距离 d 取 290 mm：轮内侧面在 333−30=303 mm，留 13 mm 支架间隙。
  【假设】轮宽 60 mm、雷达安装位姿、质量分配 —— 均在 docs/engineering/robot_model.md 5.1 列出

  坐标：x 前 / y 左 / z 上；base_link 在轮轴平面；base_footprint 在地面。
-->
<robot name="robot_a" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== 可调参数（全部来自 PDF 或文档化的假设） ==================== -->
  <xacro:arg name="half_x"        default="0.3215"/>   <!-- W643/2 -->
  <xacro:arg name="half_y"        default="0.3280"/>   <!-- L656/2 -->
  <xacro:arg name="face_dist"     default="0.2900"/>   <!-- 45° 斜面法向距离（轮内侧留 13 mm 支架间隙） -->
  <xacro:arg name="body_height"   default="0.2260"/>   <!-- 251 − 25 离地 -->
  <xacro:arg name="ground_clear"  default="0.0250"/>
  <xacro:arg name="wheel_radius"  default="0.1050"/>   <!-- 8 寸 = 210 mm -->
  <xacro:arg name="wheel_width"   default="0.0600"/>   <!-- 假设 -->
  <xacro:arg name="wheel_center_r" default="0.23546"/> <!-- 轮心 |x|=|y|：e=726/2−W/2=333 mm，c=e/√2 -->
  <xacro:arg name="chassis_mass"  default="48.47"/>
  <xacro:arg name="wheel_mass"    default="4.0"/>
  <xacro:arg name="wheel_effort"  default="20.0"/>
  <xacro:arg name="max_speed"     default="2.0"/>
  <xacro:arg name="lidar_mass"    default="0.265"/>
  <xacro:arg name="lidar_size"    default="0.065"/>
  <xacro:arg name="lidar_offset"  default="0.130"/>    <!-- 对角 |x|=|y|，假设 -->
  <xacro:arg name="lidar_mast"    default="0.040"/>    <!-- 支座高，假设 -->
  <xacro:arg name="mesh_dir"      default="package://robot_description/meshes"/>

  <xacro:property name="half_x"         value="$(arg half_x)"/>
  <xacro:property name="half_y"         value="$(arg half_y)"/>
  <xacro:property name="face_dist"      value="$(arg face_dist)"/>
  <xacro:property name="body_height"    value="$(arg body_height)"/>
  <xacro:property name="ground_clear"   value="$(arg ground_clear)"/>
  <xacro:property name="wheel_radius"   value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width"    value="$(arg wheel_width)"/>
  <xacro:property name="wheel_center_r" value="$(arg wheel_center_r)"/>
  <xacro:property name="chassis_mass"   value="$(arg chassis_mass)"/>
  <xacro:property name="wheel_mass"     value="$(arg wheel_mass)"/>
  <xacro:property name="wheel_effort"   value="$(arg wheel_effort)"/>
  <xacro:property name="lidar_mass"     value="$(arg lidar_mass)"/>
  <xacro:property name="lidar_size"     value="$(arg lidar_size)"/>
  <xacro:property name="lidar_offset"   value="$(arg lidar_offset)"/>
  <xacro:property name="lidar_mast"     value="$(arg lidar_mast)"/>
  <xacro:property name="mesh_dir"       value="$(arg mesh_dir)"/>

  <!-- 派生量 -->
  <xacro:property name="base_link_z"   value="${wheel_radius}"/>                      <!-- 轮轴平面离地 -->
  <xacro:property name="body_bottom_z" value="${ground_clear - wheel_radius}"/>       <!-- 相对 base_link -->
  <xacro:property name="body_top_z"    value="${body_bottom_z + body_height}"/>       <!-- = 0.251 − 0.105 -->
  <xacro:property name="body_center_z" value="${body_bottom_z + body_height/2.0}"/>
  <xacro:property name="wheel_vel_max" value="${1.05 * 2.0 / wheel_radius}"/>

  <!-- 惯量宏 -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertia ixx="${m*(w*w + h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(l*l + h*h)/12.0}" iyz="0" izz="${m*(l*l + w*w)/12.0}"/>
  </xacro:macro>
  <xacro:macro name="cyl_inertia_z" params="m r l">
    <inertia ixx="${m*(3*r*r + l*l)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r + l*l)/12.0}" iyz="0" izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ==================== 基座坐标系 ==================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== 八边形车体（网格：凸体，碰撞用凸包即精确） ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_center_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <!-- 八边形近似为等包络长方体（偏保守），见 docs/engineering/robot_model.md -->
      <xacro:box_inertia m="${chassis_mass}" l="${2*half_x}" w="${2*half_y}" h="${body_height}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/agl_chassis_octagon.stl"/>
      </geometry>
      <material name="chassis_black">
        <color rgba="0.18 0.18 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/agl_chassis_octagon.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- 顶部中央安装板（人形上装接口 254 × 190）：只建坐标帧，不建几何 -->
  <link name="mount_plate_link"/>
  <joint name="base_mount_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount_plate_link"/>
    <origin xyz="0 0 ${body_top_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== 四个 45° 全向轮 ====================
       位置：四个斜面中心，轮心 |x| = |y| = wheel_center_r（由 726 包络反解）
       朝向：轮面沿 45° 斜面，轮轴 = 斜面法向（水平，45°）
       关节坐标系：先用 rpy=(90°,0,φ+90°) 把子坐标系 z 轴转到轮轴方向，
                   再用 axis=(0,0,1) —— 这样轮子的圆柱几何与惯量都天然对齐轴向。
       fl = +x/+y（NE 斜面）, fr = +x/−y（SE）, rl = −x/+y（NW）, rr = −x/−y（SW）
  -->
  <xacro:macro name="omni_wheel" params="name cx cy yaw_axis_deg">
    <link name="wheel_${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cyl_inertia_z m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="base_wheel_${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${name}_link"/>
      <origin xyz="${cx} ${cy} 0" rpy="${pi/2} 0 ${yaw_axis_deg*pi/180}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${wheel_effort}" velocity="${wheel_vel_max}"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:omni_wheel name="fl" cx="${ wheel_center_r}" cy="${ wheel_center_r}" yaw_axis_deg="135"/>
  <xacro:omni_wheel name="fr" cx="${ wheel_center_r}" cy="${-wheel_center_r}" yaw_axis_deg="45"/>
  <xacro:omni_wheel name="rl" cx="${-wheel_center_r}" cy="${ wheel_center_r}" yaw_axis_deg="225"/>
  <xacro:omni_wheel name="rr" cx="${-wheel_center_r}" cy="${-wheel_center_r}" yaw_axis_deg="315"/>

  <!-- ==================== 感知：2 × 3D 固态雷达（对角）+ IMU ====================
       假设：安装在顶部对角 (±lidar_offset, ±lidar_offset)，支座高 lidar_mast。
       PDF 只写「对角安装 360° 扫描 −7~52°、40 m@10%」，未给坐标（E08 复核）。
  -->
  <xacro:macro name="solid_state_lidar" params="name sx sy">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${lidar_mass}"/>
        <xacro:box_inertia m="${lidar_mass}" l="${lidar_size}" w="${lidar_size}" h="${lidar_size}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${lidar_size} ${lidar_size} ${lidar_size}"/>
        </geometry>
        <material name="sensor_dark">
          <color rgba="0.08 0.08 0.08 1"/>
        </material>
      </visual>
      <!-- 感知器件不参与碰撞 -->
    </link>
    <joint name="base_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${sx*lidar_offset} ${sy*lidar_offset} ${body_top_z + lidar_mast + lidar_size/2.0}"
              rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:solid_state_lidar name="lidar_front" sx="1"  sy="1"/>
  <xacro:solid_state_lidar name="lidar_rear"  sx="-1" sy="-1"/>

  <!-- IMU：PDF 2.5 明确集成于 3D 雷达内（200 Hz） -->
  <link name="imu_link"/>
  <joint name="lidar_front_imu_joint" type="fixed">
    <parent link="lidar_front_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
